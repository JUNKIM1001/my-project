# Google AI Studio で発行した Gemini API キー（課金を有効化しておくこと）
# このファイルを .env にコピーして自分のキーを設定してください:
#   cp .env.example .env
GEMINI_API_KEY=

# --- Googleスプレッドシート連携（有効リード管理） ---
# セットアップ手順は docs/sheets-lead-management.md を参照
# GCPで発行したサービスアカウント鍵JSONのパス
GOOGLE_SERVICE_ACCOUNT_FILE=
# 同期先スプレッドシートのID（URLの /d/ と /edit の間の文字列）
# ※シートをサービスアカウントのメールアドレスに「編集者」で共有しておくこと
LEADS_SPREADSHEET_ID=
# ワークシート名（省略時: 有効リード）
LEADS_WORKSHEET_NAME=
